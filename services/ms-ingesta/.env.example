NODE_ENV=development
PORT=3000
GRPC_PORT=9091
MONGODB_URI=mongodb://platform_admin:platform_admin_dev@localhost:27017/ingestion_db?authSource=admin&replicaSet=rs0
RABBITMQ_URL=amqp://platform_user:platform_dev@localhost:5672/recruitment
RABBITMQ_EXCHANGE=recruitment.events
NOTIFICATIONS_QUEUE=notifications.events
# Set this in the deployment environment; never commit a service account key.
FIREBASE_SERVICE_ACCOUNT_JSON=
RABBITMQ_SAGA_QUEUE=ingesta.saga.commands
AI_NODE_GRPC_URL=localhost:50051
MS_RANKING_GRPC_URL=localhost:50052
PROTO_PATH=../../proto/recruitment.proto
OUTBOX_POLL_INTERVAL_MS=1000
