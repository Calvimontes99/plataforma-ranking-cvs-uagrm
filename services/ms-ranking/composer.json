{
  "name": "recruitment/ms-ranking",
  "description": "Clean Architecture ranking and hiring saga coordinator",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "aws/aws-sdk-php": "^3.337",
    "guzzlehttp/guzzle": "^7.9",
    "laravel/framework": "^11.0",
    "php-amqplib/php-amqplib": "^3.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ],
    "test": "vendor/bin/phpunit --do-not-cache-result"
  },
  "config": {
    "audit": {
      "block-insecure": false
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
