APP_NAME=ms-ranking
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr
LOG_LEVEL=info

AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_DEFAULT_REGION=us-east-1
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
DYNAMODB_RANKING_TABLE=recruitment_rankings
DYNAMODB_SAGA_TABLE=recruitment_saga_states
DYNAMODB_IDEMPOTENCY_TABLE=recruitment_idempotency
DYNAMODB_AUDIT_TABLE=recruitment_audit_log
DYNAMODB_OUTBOX_TABLE=recruitment_outbox_events
IDEMPOTENCY_TTL_SECONDS=86400

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=platform_user
RABBITMQ_PASSWORD=platform_dev
RABBITMQ_VHOST=recruitment
RABBITMQ_EXCHANGE=recruitment.events
RABBITMQ_SAGA_QUEUE=ranking.saga.events

AI_NODE_HTTP_URL=http://ai-node:8000
VACANCY_GRPC_ADDRESS=ms-vacantes:9090
VACANCY_GRPC_TIMEOUT_SECONDS=5
RANKING_PAGE_SIZE=100
